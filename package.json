{
  "name": "pi-simple-ui",
  "productName": "Pi Desktop",
  "description": "A desktop companion for native Pi coding-agent sessions.",
  "author": "NickPittas <NickPittas@users.noreply.github.com>",
  "homepage": "https://github.com/NickPittas/pi-simple-ui",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:vendor": "sh scripts/build-vendor.sh",
    "build": "npm run build:vendor && npm run typecheck && electron-vite build",
    "dist:mac": "npm run build && PATH=\"$PWD/scripts/bin:$PATH\" electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run build && PATH=\"$PWD/scripts/bin:$PATH\" electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@app/pi-subagents-nicobailon": "workspace:pi-subagents@0.75.0",
    "@earendil-works/pi-coding-agent": "workspace:1.0.1",
    "@jmcombs/pi-1password": "file:vendor/pi-1password",
    "@tintinweb/pi-subagents": "workspace:0.19.0",
    "@tintinweb/pi-tasks": "file:vendor/pi-tasks",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "pi-powerline-footer": "file:vendor/pi-powerline-footer",
    "pi-web-access": "file:vendor/pi-web-access",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "shx": "0.4.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "node-pty"
    ]
  }
}
